---
import Layout from '../layouts/Layout.astro';
import ConversionTable from '../components/ConversionTable.astro';

const gradeDefinitions = [
  { grade: 'AA', points: '10', description: 'Excellent / Outstanding', marks: '90 - 100%' },
  { grade: 'AB', points: '9', description: 'Very Good', marks: '80 - 89%' },
  { grade: 'BB', points: '8', description: 'Good', marks: '70 - 79%' },
  { grade: 'BC', points: '7', description: 'Above Average', marks: '60 - 69%' },
  { grade: 'CC', points: '6', description: 'Average', marks: '50 - 59%' },
  { grade: 'CD', points: '5', description: 'Below Average', marks: '45 - 49%' },
  { grade: 'DD', points: '4', description: 'Marginal Pass', marks: '40 - 44%' },
  { grade: 'FF', points: '0', description: 'Fail / Unsatisfactory', marks: '< 40%' },
  { grade: 'XX', points: '0', description: 'Course Ineligible (Attendance < 50%)', marks: 'N/A' },
];
---

<Layout
  title="How It's Calculated | WCE Academic Rules & CGPA Conversion Formula"
  description="Comprehensive breakdown of Walchand College of Engineering (WCE) Sangli Academic and Examination Rules and Regulations 2023-24, Section 12 & Section 16."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- Header -->
    <div class="space-y-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-binance-card border border-amber-300 dark:border-binance-yellow/30 text-xs font-mono text-amber-800 dark:text-binance-yellow">
        <span>Academic and Examination Rules (RR 2023-24)</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white">
        Official WCE <span class="text-amber-600 dark:text-binance-yellow">Conversion Formula</span> & Rules
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-binance-muted max-w-2xl mx-auto leading-relaxed">
        Walchand College of Engineering, Sangli (An Autonomous Institute) follows a 10-point Relative/Absolute grading scale. Here is the authoritative regulatory documentation.
      </p>
    </div>

    <!-- Section 16: The Formula -->
    <div id="formula" class="bg-white dark:bg-binance-card rounded-2xl border border-slate-200 dark:border-binance-border p-6 md:p-8 space-y-6 shadow-xs transition-colors duration-150">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-800 dark:bg-binance-yellow/10 dark:text-binance-yellow border border-amber-300 dark:border-binance-yellow/20 flex items-center justify-center font-mono font-bold">
          16
        </span>
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Section 16: CGPA to Percentage Conversion</h2>
          <p class="text-xs text-slate-500 dark:text-binance-muted">Ordinance governing transcript generation & equivalence</p>
        </div>
      </div>

      <p class="text-sm text-slate-700 dark:text-binance-text leading-relaxed">
        For the purpose of converting Cumulative Grade Point Average (CGPA) into equivalent percentage of marks, the Academic Council of Walchand College of Engineering, Sangli defines the following uniform linear relation:
      </p>

      <div class="bg-slate-50 dark:bg-binance-canvas rounded-xl p-6 border border-slate-200 dark:border-binance-border text-center space-y-2">
        <span class="text-xs font-mono text-slate-500 dark:text-binance-muted uppercase tracking-widest block">Official Formula</span>
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-amber-600 dark:text-binance-yellow">
          Percentage (%) = (10.00 × CGPA) − 7.50
        </div>
        <span class="text-xs font-mono text-emerald-600 dark:text-binance-up block">Valid Range: CGPA 5.00 to 10.00</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs text-slate-600 dark:text-binance-muted">
        <div class="p-4 rounded-lg bg-slate-50 dark:bg-binance-canvas border border-slate-200 dark:border-binance-border space-y-1">
          <span class="text-slate-900 dark:text-white font-bold block">Worked Example (From Regulations)</span>
          <p>CGPA = 7.80</p>
          <p class="text-amber-700 dark:text-binance-yellow font-semibold">Percentage = (10.00 × 7.80) − 7.50 = 70.50%</p>
        </div>
        <div class="p-4 rounded-lg bg-slate-50 dark:bg-binance-canvas border border-slate-200 dark:border-binance-border space-y-1">
          <span class="text-slate-900 dark:text-white font-bold block">Official Verification Point</span>
          <p>CGPA = 6.75</p>
          <p class="text-amber-700 dark:text-binance-yellow font-semibold">Percentage = (10.00 × 6.75) − 7.50 = 60.00%</p>
        </div>
      </div>
    </div>

    <!-- Section 12: Table 16.1 - Grade Letter & Points Mapping (Course-Level) -->
    <div id="grading-scale" class="bg-white dark:bg-binance-card rounded-2xl border border-slate-200 dark:border-binance-border p-6 md:p-8 space-y-6 shadow-xs transition-colors duration-150">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-800 dark:bg-binance-yellow/10 dark:text-binance-yellow border border-amber-300 dark:border-binance-yellow/20 flex items-center justify-center font-mono font-bold">
          12
        </span>
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Section 12 (Table 16.1): Course Grade Points Scale</h2>
          <p class="text-xs text-slate-500 dark:text-binance-muted">Course-level grade letters, grade points, and qualitative descriptions</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono border-collapse">
          <thead>
            <tr class="bg-slate-100 dark:bg-binance-canvas text-slate-600 dark:text-binance-muted uppercase text-[11px] border-b border-slate-200 dark:border-binance-border">
              <th class="py-3 px-4">Grade Letter</th>
              <th class="py-3 px-4">Grade Points</th>
              <th class="py-3 px-4">Qualitative Description</th>
              <th class="py-3 px-4">Marks Range Indicator</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-binance-border/50">
            {gradeDefinitions.map(g => (
              <tr class="hover:bg-slate-50 dark:hover:bg-binance-elevated/40 transition-colors">
                <td class="py-3 px-4 font-bold text-slate-900 dark:text-white flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-binance-canvas border border-slate-200 dark:border-binance-border text-amber-700 dark:text-binance-yellow">
                    {g.grade}
                  </span>
                </td>
                <td class="py-3 px-4 font-bold text-emerald-600 dark:text-binance-up">{g.points}</td>
                <td class="py-3 px-4 text-slate-700 dark:text-binance-text">{g.description}</td>
                <td class="py-3 px-4 text-slate-500 dark:text-binance-muted">{g.marks}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Conversion Reference Table Component -->
    <ConversionTable />

  </div>
</Layout>
