---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Feedback | WCE CGPA to Percentage Calculator"
  description="Send feedback, report formula questions, or suggest features for the WCE CGPA Calculator."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-binance-card border border-binance-yellow/30 text-xs font-mono text-binance-yellow">
        <span>Get in Touch</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Contact & <span class="text-binance-yellow">Feedback</span>
      </h1>
      <p class="text-sm text-binance-muted max-w-xl mx-auto leading-relaxed">
        Have questions about the conversion formula, found a discrepancy in a syllabus regulation, or want to suggest new features? Reach out!
      </p>
    </div>

    <!-- Contact Form Card in Binance theme -->
    <div class="bg-binance-card rounded-2xl border border-binance-border p-6 md:p-8 binance-glow-card">
      <form id="contact-form" class="space-y-5 text-xs font-mono">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="block text-binance-text font-medium">Your Name</label>
            <input
              type="text"
              required
              placeholder="e.g. Rahul Patil"
              class="w-full bg-binance-canvas border border-binance-border focus:border-binance-yellow text-white px-3.5 py-2.5 rounded-xl outline-none transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-binance-text font-medium">Email Address</label>
            <input
              type="email"
              required
              placeholder="e.g. rahul@example.com"
              class="w-full bg-binance-canvas border border-binance-border focus:border-binance-yellow text-white px-3.5 py-2.5 rounded-xl outline-none transition-colors"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="block text-binance-text font-medium">Department / Branch</label>
          <select class="w-full bg-binance-canvas border border-binance-border focus:border-binance-yellow text-white px-3.5 py-2.5 rounded-xl outline-none transition-colors">
            <option>Computer Science & Engineering (CSE)</option>
            <option>Information Technology (IT)</option>
            <option>Electronics Engineering</option>
            <option>Electrical Engineering</option>
            <option>Mechanical Engineering</option>
            <option>Civil Engineering</option>
            <option>Alumni / Other</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label class="block text-binance-text font-medium">Subject / Topic</label>
          <input
            type="text"
            required
            placeholder="e.g. Question on 2024 revised grading circular"
            class="w-full bg-binance-canvas border border-binance-border focus:border-binance-yellow text-white px-3.5 py-2.5 rounded-xl outline-none transition-colors"
          />
        </div>

        <div class="space-y-1.5">
          <label class="block text-binance-text font-medium">Message / Query</label>
          <textarea
            rows="4"
            required
            placeholder="Write your query or feedback here..."
            class="w-full bg-binance-canvas border border-binance-border focus:border-binance-yellow text-white px-3.5 py-2.5 rounded-xl outline-none transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit-btn"
          class="w-full py-3 rounded-xl bg-binance-yellow hover:bg-binance-yellow-hover text-binance-ink font-bold text-sm transition-all flex items-center justify-center gap-2"
        >
          <span>Send Message</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>

        <div id="contact-success" class="hidden p-3 rounded-xl bg-binance-up/10 border border-binance-up/30 text-binance-up text-center font-bold">
          Thank you! Your feedback has been received.
        </div>

      </form>
    </div>

  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('opacity-50');
      }
      setTimeout(() => {
        successMsg.classList.remove('hidden');
        form.reset();
      }, 600);
    });
  }
</script>
