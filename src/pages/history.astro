---
import Layout from '../layouts/Layout.astro';
import HistoryPanel from '../components/HistoryPanel.astro';
---

<Layout
  title="Calculation History | WCE CGPA to Percentage Calculator"
  description="View your saved WCE CGPA and percentage conversion logs."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="space-y-3 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-binance-card border border-binance-yellow/30 text-xs font-mono text-binance-yellow">
        <span>Local History Storage</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
        Conversion <span class="text-binance-yellow">History</span>
      </h1>
      <p class="text-sm text-binance-muted max-w-md mx-auto">
        Review previously calculated CGPA conversions saved in your browser.
      </p>
    </div>

    <HistoryPanel />

    <div class="text-center pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-binance-canvas hover:bg-binance-card border border-binance-border text-white text-xs font-semibold transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Back to Calculator</span>
      </a>
    </div>
  </div>
</Layout>
