---
import Layout from '../layouts/Layout.astro';
import ConversionTable from '../components/ConversionTable.astro';

const gradeDefinitions = [
  { grade: 'AA', points: '10', description: 'Excellent / Outstanding', marks: '90 - 100%' },
  { grade: 'AB', points: '9', description: 'Very Good', marks: '80 - 89%' },
  { grade: 'BB', points: '8', description: 'Good', marks: '70 - 79%' },
  { grade: 'BC', points: '7', description: 'Above Average', marks: '60 - 69%' },
  { grade: 'CC', points: '6', description: 'Average', marks: '50 - 59%' },
  { grade: 'CD', points: '5', description: 'Below Average', marks: '45 - 49%' },
  { grade: 'DD', points: '4', description: 'Marginal Pass', marks: '40 - 44%' },
  { grade: 'FF', points: '0', description: 'Fail / Unsatisfactory', marks: '< 40%' },
  { grade: 'XX', points: '0', description: 'Course Ineligible (Attendance < 50%)', marks: 'N/A' },
];

const classAwardList = [
  { award: 'First Class with Distinction', cgpaReq: 'CGPA ≥ 8.25', pctReq: 'Percentage ≥ 75.00%', desc: 'Passed all examinations in first attempt with exemplary academic standing.' },
  { award: 'First Class', cgpaReq: '6.75 ≤ CGPA < 8.25', pctReq: '60.00% ≤ Percentage < 75.00%', desc: 'Demonstrates solid mastery of engineering subjects.' },
  { award: 'Higher Second Class', cgpaReq: '6.25 ≤ CGPA < 6.75', pctReq: '55.00% ≤ Percentage < 60.00%', desc: 'Above average academic standard.' },
  { award: 'Second Class', cgpaReq: '5.75 ≤ CGPA < 6.25', pctReq: '50.00% ≤ Percentage < 55.00%', desc: 'Satisfactory standard across curriculum.' },
  { award: 'Pass Class', cgpaReq: '4.75 ≤ CGPA < 5.75', pctReq: '40.00% ≤ Percentage < 50.00%', desc: 'Minimum passing standard achieved.' },
];
---

<Layout
  title="WCE Academic Rules & CGPA Conversion Formula | Official Guide"
  description="Comprehensive breakdown of Walchand College of Engineering (WCE) Sangli Academic and Examination Rules and Regulations 2023-24, Section 12 & Section 16."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- Header -->
    <div class="space-y-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-binance-card border border-binance-yellow/30 text-xs font-mono text-binance-yellow">
        <span>Academic and Examination Rules (RR 2023-24)</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white">
        Official WCE <span class="text-binance-yellow">Conversion Formula</span> & Rules
      </h1>
      <p class="text-sm sm:text-base text-binance-muted max-w-2xl mx-auto leading-relaxed">
        Walchand College of Engineering, Sangli (An Autonomous Institute) follows a 10-point Relative/Absolute grading scale. Here is the authoritative regulatory documentation.
      </p>
    </div>

    <!-- Section 16: The Formula -->
    <div id="formula" class="bg-binance-card rounded-2xl border border-binance-border p-6 md:p-8 space-y-6">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-binance-yellow/10 border border-binance-yellow/20 flex items-center justify-center font-mono font-bold text-binance-yellow">
          16
        </span>
        <div>
          <h2 class="text-xl font-bold text-white">Section 16: CGPA to Percentage Conversion</h2>
          <p class="text-xs text-binance-muted">Ordinance governing transcript generation & equivalence</p>
        </div>
      </div>

      <p class="text-sm text-binance-text leading-relaxed">
        For the purpose of converting Cumulative Grade Point Average (CGPA) into equivalent percentage of marks, the Academic Council of Walchand College of Engineering, Sangli defines the following uniform linear relation:
      </p>

      <div class="bg-binance-canvas rounded-xl p-6 border border-binance-border text-center space-y-2">
        <span class="text-xs font-mono text-binance-muted uppercase tracking-widest block">Official Formula</span>
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-binance-yellow">
          Percentage (%) = (10.00 × CGPA) − 7.50
        </div>
        <span class="text-xs font-mono text-binance-up block">Valid Range: CGPA 5.00 to 10.00</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs text-binance-muted">
        <div class="p-4 rounded-lg bg-binance-canvas border border-binance-border space-y-1">
          <span class="text-white font-bold block">Example 1: Top Bracket</span>
          <p>CGPA = 9.20</p>
          <p class="text-binance-yellow font-semibold">Percentage = (10.00 × 9.20) − 7.50 = 84.50%</p>
        </div>
        <div class="p-4 rounded-lg bg-binance-canvas border border-binance-border space-y-1">
          <span class="text-white font-bold block">Example 2: First Class Cutoff</span>
          <p>CGPA = 6.75</p>
          <p class="text-binance-yellow font-semibold">Percentage = (10.00 × 6.75) − 7.50 = 60.00%</p>
        </div>
      </div>
    </div>

    <!-- Section 12: Table 16.1 - Grade Letter & Points Mapping -->
    <div id="grading-scale" class="bg-binance-card rounded-2xl border border-binance-border p-6 md:p-8 space-y-6">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-binance-yellow/10 border border-binance-yellow/20 flex items-center justify-center font-mono font-bold text-binance-yellow">
          12
        </span>
        <div>
          <h2 class="text-xl font-bold text-white">Section 12 (Table 16.1): Official 10-Point Grading Scale</h2>
          <p class="text-xs text-binance-muted">Grade Letter definitions, Grade Points, and Qualitative Assessment</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono border-collapse">
          <thead>
            <tr class="bg-binance-canvas text-binance-muted uppercase text-[11px] border-b border-binance-border">
              <th class="py-3 px-4">Grade Letter</th>
              <th class="py-3 px-4">Grade Points</th>
              <th class="py-3 px-4">Qualitative Description</th>
              <th class="py-3 px-4">Equivalent Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-binance-border/50">
            {gradeDefinitions.map(g => (
              <tr class="hover:bg-binance-elevated/40 transition-colors">
                <td class="py-3 px-4 font-bold text-white flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-binance-canvas border border-binance-border text-binance-yellow">
                    {g.grade}
                  </span>
                </td>
                <td class="py-3 px-4 font-bold text-binance-up">{g.points}</td>
                <td class="py-3 px-4 text-binance-text">{g.description}</td>
                <td class="py-3 px-4 text-binance-muted">{g.marks}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Award of Degree Classes -->
    <div class="bg-binance-card rounded-2xl border border-binance-border p-6 md:p-8 space-y-6">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-binance-yellow/10 border border-binance-yellow/20 flex items-center justify-center font-mono font-bold text-binance-yellow">
          ★
        </span>
        <div>
          <h2 class="text-xl font-bold text-white">Award of Class & Degree Honours</h2>
          <p class="text-xs text-binance-muted">Classification awarded upon graduation based on final CGPA</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
        {classAwardList.map(c => (
          <div class="p-4 rounded-xl bg-binance-canvas border border-binance-border space-y-2">
            <span class="text-sm font-bold text-white block">{c.award}</span>
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-binance-card border border-binance-border text-binance-yellow">{c.cgpaReq}</span>
              <span class="text-binance-muted">|</span>
              <span class="text-binance-up font-semibold">{c.pctReq}</span>
            </div>
            <p class="text-[11px] text-binance-muted leading-relaxed font-sans">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Conversion Reference Table Component -->
    <ConversionTable />

  </div>
</Layout>
