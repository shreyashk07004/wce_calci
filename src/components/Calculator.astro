---
// Calculator.astro - Binance-themed WCE CGPA to Percentage Conversion Terminal
---

<div id="calculator" class="w-full max-w-4xl mx-auto">
  <div class="relative bg-binance-card rounded-2xl border border-binance-border binance-glow-card overflow-hidden">
    
    <!-- Top Header Bar with Terminal/Market vibe -->
    <div class="bg-binance-elevated/80 px-6 py-4 border-b border-binance-border flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-binance-yellow animate-pulse"></span>
        <h2 class="text-sm font-semibold tracking-wide text-white uppercase flex items-center gap-2">
          <span>WCE CGPA Converter</span>
          <span class="text-xs text-binance-muted font-mono font-normal">v2023-24</span>
        </h2>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-binance-muted">
        <span class="px-2 py-0.5 rounded bg-binance-canvas border border-binance-border text-binance-up">
          Active Formula: (10.00 × CGPA) − 7.50
        </span>
      </div>
    </div>

    <div class="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Input Form & Controls (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Input Group -->
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label for="cgpa-input" class="text-sm font-medium text-binance-text">
              Enter Cumulative GPA (CGPA)
            </label>
            <span class="text-xs text-binance-muted font-mono">Scale: 0.00 – 10.00</span>
          </div>

          <div class="relative flex items-center">
            <input
              type="number"
              id="cgpa-input"
              step="0.01"
              min="0"
              max="10"
              placeholder="e.g. 8.45"
              value="8.50"
              class="w-full bg-binance-canvas border-2 border-binance-border hover:border-binance-muted focus:border-binance-yellow text-white text-2xl md:text-3xl font-bold font-mono px-4 py-3.5 rounded-xl outline-none transition-all placeholder:text-binance-muted/40"
            />
            <div class="absolute right-3 flex items-center gap-1.5">
              <button
                id="clear-btn"
                type="button"
                title="Clear input"
                class="p-1.5 text-binance-muted hover:text-white rounded-lg hover:bg-binance-elevated transition-colors"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
              <span class="text-xs font-semibold px-2 py-1 rounded bg-binance-elevated text-binance-yellow border border-binance-border font-mono">
                CGPA
              </span>
            </div>
          </div>

          <!-- Range Slider for Tactile Feedback -->
          <div class="pt-2">
            <input
              type="range"
              id="cgpa-slider"
              min="0"
              max="10"
              step="0.01"
              value="8.50"
              class="w-full h-2 bg-binance-canvas rounded-lg appearance-none cursor-pointer accent-binance-yellow"
            />
            <div class="flex justify-between text-[11px] text-binance-muted font-mono pt-1">
              <span>0.00</span>
              <span>5.00 (Pass Range)</span>
              <span>7.50 (Distinction)</span>
              <span>10.00</span>
            </div>
          </div>
        </div>

        <!-- Quick Presets Pills -->
        <div class="space-y-2">
          <label class="text-xs font-semibold text-binance-muted uppercase tracking-wider">Quick Presets</label>
          <div class="flex flex-wrap gap-1.5" id="presets-container">
            {['10.00', '9.50', '9.00', '8.50', '8.00', '7.75', '7.50', '7.00', '6.75', '6.50', '6.00', '5.50'].map(val => (
              <button
                type="button"
                data-preset={val}
                class="preset-btn px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-binance-canvas border border-binance-border text-binance-text hover:border-binance-yellow hover:text-binance-yellow transition-all"
              >
                {val}
              </button>
            ))}
          </div>
        </div>

        <!-- Calculation Step Breakdown -->
        <div class="bg-binance-canvas/80 rounded-xl p-4 border border-binance-border/80 space-y-2">
          <span class="text-xs font-semibold text-binance-muted uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Calculation Breakdown
          </span>
          <div class="font-mono text-sm space-y-1 text-binance-text" id="breakdown-steps">
            <div class="text-xs text-binance-muted">Step 1: Multiply CGPA by 10.00</div>
            <div class="text-binance-yellow font-medium" id="step1-text">10.00 × 8.50 = 85.00</div>
            <div class="text-xs text-binance-muted pt-1">Step 2: Subtract constant 7.50</div>
            <div class="text-binance-up font-bold" id="step2-text">85.00 − 7.50 = 77.50%</div>
          </div>
        </div>

        <!-- Note / Warning Alert Container -->
        <div id="range-warning" class="hidden p-3 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs flex items-start gap-2">
          <svg class="w-4 h-4 shrink-0 mt-0.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <div>
            <span class="font-bold">Official Guidance:</span> WCE officially defines this conversion formula for CGPA ≥ 5.00. Values below 5.00 are evaluated per individual board committee guidelines.
          </div>
        </div>

      </div>

      <!-- Right Column: Results Board & Visual Dial (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center bg-binance-canvas/90 rounded-2xl p-6 border border-binance-border relative">
        
        <!-- Glowing Accent light -->
        <div class="absolute -top-10 -right-10 w-40 h-40 bg-binance-yellow/5 rounded-full blur-3xl pointer-events-none"></div>

        <span class="text-xs font-semibold text-binance-muted uppercase tracking-wider mb-2">Equated Percentage</span>

        <!-- Percentage Display -->
        <div class="text-center my-3">
          <div class="flex items-baseline justify-center gap-1">
            <span id="result-percentage" class="text-5xl md:text-6xl font-extrabold font-mono text-binance-yellow tracking-tight drop-shadow-sm">
              77.50
            </span>
            <span class="text-2xl md:text-3xl font-bold font-mono text-binance-yellow">%</span>
          </div>
          <div id="result-badge" class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-binance-up/10 text-binance-up border border-binance-up/20">
            <span class="w-1.5 h-1.5 rounded-full bg-binance-up"></span>
            <span id="result-class-text">First Class with Distinction</span>
          </div>
        </div>

        <!-- Grade Point & Equated Level Grid -->
        <div class="w-full grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-binance-border text-center font-mono">
          <div class="p-2.5 rounded-lg bg-binance-card border border-binance-border">
            <span class="text-[11px] text-binance-muted block">Grade Equivalent</span>
            <span id="result-grade" class="text-base font-bold text-white">AB (Very Good)</span>
          </div>
          <div class="p-2.5 rounded-lg bg-binance-card border border-binance-border">
            <span class="text-[11px] text-binance-muted block">Passing Status</span>
            <span id="result-status" class="text-base font-bold text-binance-up">PASSED</span>
          </div>
        </div>

        <!-- Action Buttons (Copy, Save, Share) -->
        <div class="w-full grid grid-cols-2 gap-2 mt-4">
          <button
            id="copy-result-btn"
            type="button"
            class="w-full py-2.5 px-3 rounded-lg bg-binance-card hover:bg-binance-elevated border border-binance-border text-white text-xs font-medium flex items-center justify-center gap-1.5 transition-all"
          >
            <svg class="w-3.5 h-3.5 text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-btn-text">Copy Result</span>
          </button>

          <button
            id="save-history-btn"
            type="button"
            class="w-full py-2.5 px-3 rounded-lg bg-binance-yellow hover:bg-binance-yellow-hover text-binance-ink text-xs font-bold flex items-center justify-center gap-1.5 transition-all"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>Save Log</span>
          </button>
        </div>

        <div id="toast-msg" class="hidden absolute bottom-2 px-3 py-1 rounded bg-binance-up text-binance-ink text-xs font-bold shadow-lg transition-all">
          Copied to clipboard!
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  import confetti from 'canvas-confetti';

  function calculatePercentage(cgpa: number) {
    if (isNaN(cgpa) || cgpa < 0) return 0;
    if (cgpa > 10) return 92.50;
    const raw = (10.00 * cgpa) - 7.50;
    return Math.max(0, Math.round((raw + Number.EPSILON) * 100) / 100);
  }

  function getClassAndGrade(cgpa: number, percentage: number) {
    let className = 'Pass Class';
    let classColor = 'text-binance-muted';
    let grade = 'DD (Marginal Pass)';
    let status = 'PASSED';

    if (percentage >= 75.00) {
      className = 'First Class with Distinction';
      classColor = 'text-binance-yellow bg-binance-yellow/10 border-binance-yellow/30';
    } else if (percentage >= 60.00) {
      className = 'First Class';
      classColor = 'text-binance-up bg-binance-up/10 border-binance-up/30';
    } else if (percentage >= 55.00) {
      className = 'Higher Second Class';
      classColor = 'text-binance-turquoise bg-binance-turquoise/10 border-binance-turquoise/30';
    } else if (percentage >= 50.00) {
      className = 'Second Class';
      classColor = 'text-blue-400 bg-blue-400/10 border-blue-400/30';
    } else if (percentage >= 40.00) {
      className = 'Pass Class';
      classColor = 'text-amber-400 bg-amber-400/10 border-amber-400/30';
    } else {
      className = 'Fail / Unsatisfactory';
      classColor = 'text-binance-down bg-binance-down/10 border-binance-down/30';
      status = 'NEEDS IMPROVEMENT';
    }

    if (cgpa >= 9.5) grade = 'AA (Outstanding)';
    else if (cgpa >= 8.5) grade = 'AB (Excellent)';
    else if (cgpa >= 7.5) grade = 'BB (Very Good)';
    else if (cgpa >= 6.5) grade = 'BC (Good)';
    else if (cgpa >= 5.5) grade = 'CC (Average)';
    else if (cgpa >= 4.5) grade = 'CD (Below Avg)';
    else if (cgpa >= 4.0) grade = 'DD (Marginal Pass)';
    else grade = 'FF (Fail)';

    return { className, classColor, grade, status };
  }

  const cgpaInput = document.getElementById('cgpa-input') as HTMLInputElement | null;
  const cgpaSlider = document.getElementById('cgpa-slider') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-btn');
  const resultPercentage = document.getElementById('result-percentage');
  const resultClassText = document.getElementById('result-class-text');
  const resultBadge = document.getElementById('result-badge');
  const resultGrade = document.getElementById('result-grade');
  const resultStatus = document.getElementById('result-status');
  const step1Text = document.getElementById('step1-text');
  const step2Text = document.getElementById('step2-text');
  const rangeWarning = document.getElementById('range-warning');
  const copyBtn = document.getElementById('copy-result-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const saveHistoryBtn = document.getElementById('save-history-btn');
  const toastMsg = document.getElementById('toast-msg');

  function updateAll(val: number, triggerConfetti = false) {
    const clampedVal = Math.min(10, Math.max(0, val));
    const percentage = calculatePercentage(clampedVal);
    const { className, classColor, grade, status } = getClassAndGrade(clampedVal, percentage);

    if (resultPercentage) {
      resultPercentage.textContent = percentage.toFixed(2);
    }
    if (resultClassText) {
      resultClassText.textContent = className;
    }
    if (resultBadge) {
      resultBadge.className = `mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ${classColor}`;
    }
    if (resultGrade) {
      resultGrade.textContent = grade;
    }
    if (resultStatus) {
      resultStatus.textContent = status;
      resultStatus.className = `text-base font-bold ${status === 'PASSED' ? 'text-binance-up' : 'text-binance-down'}`;
    }
    if (step1Text) {
      step1Text.textContent = `10.00 × ${clampedVal.toFixed(2)} = ${(10 * clampedVal).toFixed(2)}`;
    }
    if (step2Text) {
      step2Text.textContent = `${(10 * clampedVal).toFixed(2)} − 7.50 = ${percentage.toFixed(2)}%`;
    }
    if (rangeWarning) {
      if (clampedVal < 5.0 && clampedVal > 0) {
        rangeWarning.classList.remove('hidden');
      } else {
        rangeWarning.classList.add('hidden');
      }
    }

    if (triggerConfetti && percentage >= 75) {
      try {
        confetti({
          particleCount: 50,
          spread: 60,
          origin: { y: 0.7 },
          colors: ['#FCD535', '#0ECB81', '#ffffff']
        });
      } catch (e) {}
    }
  }

  if (cgpaInput && cgpaSlider) {
    cgpaInput.addEventListener('input', () => {
      const val = parseFloat(cgpaInput.value);
      if (!isNaN(val)) {
        cgpaSlider.value = String(val);
        updateAll(val);
      }
    });

    cgpaSlider.addEventListener('input', () => {
      const val = parseFloat(cgpaSlider.value);
      cgpaInput.value = val.toFixed(2);
      updateAll(val);
    });

    clearBtn?.addEventListener('click', () => {
      cgpaInput.value = '';
      cgpaSlider.value = '0';
      updateAll(0);
      cgpaInput.focus();
    });

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const val = parseFloat(target.dataset.preset || '0');
        cgpaInput.value = val.toFixed(2);
        cgpaSlider.value = String(val);
        updateAll(val, true);
      });
    });

    // Initial trigger
    updateAll(parseFloat(cgpaInput.value || '8.50'));
  }

  // Copy to clipboard action
  if (copyBtn && copyBtnText && toastMsg) {
    copyBtn.addEventListener('click', () => {
      const cgpa = cgpaInput?.value || '8.50';
      const per = resultPercentage?.textContent || '77.50';
      const grade = resultClassText?.textContent || 'First Class with Distinction';
      const text = `WCE CGPA Conversion:\nCGPA: ${cgpa}/10.00\nPercentage: ${per}%\nClassification: ${grade}\nFormula: (10 × CGPA) - 7.50`;

      navigator.clipboard.writeText(text).then(() => {
        copyBtnText.textContent = 'Copied!';
        toastMsg.classList.remove('hidden');
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Result';
          toastMsg.classList.add('hidden');
        }, 2000);
      });
    });
  }

  // Save to history storage
  if (saveHistoryBtn) {
    saveHistoryBtn.addEventListener('click', () => {
      const cgpa = parseFloat(cgpaInput?.value || '0');
      const per = parseFloat(resultPercentage?.textContent || '0');
      const gradeClass = resultClassText?.textContent || '';
      
      const item = {
        id: Date.now().toString(),
        cgpa,
        percentage: per,
        gradeClass,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
        date: new Date().toLocaleDateString()
      };

      const existing = JSON.parse(localStorage.getItem('wce_calc_history') || '[]');
      existing.unshift(item);
      localStorage.setItem('wce_calc_history', JSON.stringify(existing.slice(0, 15)));

      window.dispatchEvent(new CustomEvent('wce-history-updated'));

      if (saveHistoryBtn) {
        const origHTML = saveHistoryBtn.innerHTML;
        saveHistoryBtn.innerHTML = `
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Saved!</span>
        `;
        setTimeout(() => {
          saveHistoryBtn.innerHTML = origHTML;
        }, 1800);
      }
    });
  }
</script>
