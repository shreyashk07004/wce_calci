---
// Calculator.astro - Clean WCE CGPA to Percentage Conversion Terminal
---

<div id="calculator" class="w-full max-w-4xl mx-auto">
  <!-- Target card for UI and Export -->
  <div id="conversion-card" class="relative bg-white dark:bg-binance-card rounded-2xl border border-slate-200 dark:border-binance-border binance-glow-card overflow-hidden transition-colors duration-150">
    
    <!-- Top Header Bar -->
    <div class="bg-slate-50 dark:bg-binance-elevated/80 px-6 py-4 border-b border-slate-200 dark:border-binance-border flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-binance-yellow"></span>
        <h2 class="text-sm font-semibold tracking-wide text-slate-900 dark:text-white uppercase flex items-center gap-2">
          <span>WCE CGPA Conversion Engine</span>
          <span class="text-xs text-slate-500 dark:text-binance-muted font-mono font-normal">Section 16</span>
        </h2>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-slate-600 dark:text-binance-muted">
        <span class="px-2.5 py-1 rounded bg-white dark:bg-binance-canvas border border-slate-200 dark:border-binance-border text-emerald-700 dark:text-binance-up font-semibold">
          Formula: (10.00 × CGPA) − 7.50
        </span>
      </div>
    </div>

    <div class="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Input Form & Controls (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Input Group -->
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label for="cgpa-input" class="text-sm font-medium text-slate-900 dark:text-binance-text">
              Enter Cumulative GPA (CGPA)
            </label>
            <span class="text-xs text-slate-500 dark:text-binance-muted font-mono">Scale: 0.00 – 10.00</span>
          </div>

          <div class="relative flex items-center">
            <input
              type="number"
              id="cgpa-input"
              step="0.01"
              min="0"
              max="10"
              placeholder="e.g. 7.80"
              value=""
              class="w-full bg-slate-50 dark:bg-binance-canvas border-2 border-slate-200 dark:border-binance-border hover:border-slate-400 dark:hover:border-binance-muted focus:border-binance-yellow text-slate-900 dark:text-white text-2xl md:text-3xl font-bold font-mono px-4 py-3.5 pr-24 rounded-xl outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-binance-muted/40 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            />
            <div class="absolute right-3 flex items-center gap-2">
              <button
                id="clear-btn"
                type="button"
                title="Clear input"
                class="p-1 text-slate-400 hover:text-slate-700 dark:text-binance-muted dark:hover:text-white rounded hover:bg-slate-200 dark:hover:bg-binance-elevated transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
              <span class="text-xs font-semibold px-2 py-1 rounded bg-slate-200 dark:bg-binance-elevated text-slate-800 dark:text-binance-yellow border border-slate-300 dark:border-binance-border font-mono select-none">
                CGPA
              </span>
            </div>
          </div>

          <!-- Error Alert for Invalid Input -->
          <div id="input-error" class="hidden text-xs font-mono text-red-600 dark:text-binance-down flex items-center gap-1.5 pt-1">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span id="input-error-text">CGPA must be a valid number between 0.00 and 10.00</span>
          </div>

          <!-- Range Slider -->
          <div class="pt-2">
            <input
              type="range"
              id="cgpa-slider"
              min="0"
              max="10"
              step="0.01"
              value="0"
              class="w-full h-2 bg-slate-200 dark:bg-binance-canvas rounded-lg appearance-none cursor-pointer accent-binance-yellow"
            />
            <div class="flex justify-between text-[11px] text-slate-500 dark:text-binance-muted font-mono pt-1">
              <span>0.00</span>
              <span>5.00 (Pass Threshold)</span>
              <span>10.00</span>
            </div>
          </div>
        </div>

        <!-- Quick Test Value Presets (Official Verification Table Points) -->
        <div class="space-y-2">
          <label class="text-xs font-semibold text-slate-500 dark:text-binance-muted uppercase tracking-wider">
            Official Verification Presets (Section 16)
          </label>
          <div class="flex flex-wrap gap-1.5" id="presets-container">
            {[
              { val: '6.25', label: '6.25 (55%)' },
              { val: '6.75', label: '6.75 (60%)' },
              { val: '7.25', label: '7.25 (65%)' },
              { val: '7.75', label: '7.75 (70%)' },
              { val: '8.25', label: '8.25 (75%)' },
              { val: '7.80', label: '7.80 (Worked Example)' },
              { val: '4.50', label: '4.50 (< 5.00)' },
              { val: '10.00', label: '10.00 (Max)' },
            ].map(item => (
              <button
                type="button"
                data-preset={item.val}
                class="preset-btn px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 dark:bg-binance-canvas dark:border-binance-border dark:text-binance-text hover:border-binance-yellow hover:text-binance-yellow dark:hover:border-binance-yellow dark:hover:text-binance-yellow transition-all cursor-pointer"
              >
                {item.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Calculation Step Breakdown -->
        <div class="bg-slate-50 dark:bg-binance-canvas/80 rounded-xl p-4 border border-slate-200 dark:border-binance-border/80 space-y-2">
          <span class="text-xs font-semibold text-slate-600 dark:text-binance-muted uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-amber-600 dark:text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            Step-by-Step Formula Breakdown
          </span>
          <div class="font-mono text-sm space-y-1 text-slate-800 dark:text-binance-text" id="breakdown-steps">
            <div class="text-xs text-slate-500 dark:text-binance-muted">Step 1: Multiply CGPA by 10.00</div>
            <div class="text-amber-700 dark:text-binance-yellow font-medium" id="step1-text">10.00 × -- = --</div>
            <div class="text-xs text-slate-500 dark:text-binance-muted pt-1">Step 2: Subtract constant 7.50</div>
            <div class="text-emerald-700 dark:text-binance-up font-bold" id="step2-text">-- − 7.50 = --%</div>
          </div>
        </div>

        <!-- Warning Alert for CGPA < 5.00 -->
        <div id="range-warning" class="hidden p-3 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs flex items-start gap-2">
          <svg class="w-4 h-4 shrink-0 mt-0.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <div>
            <span class="font-bold">Official Note (Section 16):</span> This conversion formula is officially defined by WCE for CGPA ≥ 5.00. Values below 5.00 are displayed for mathematical reference only.
          </div>
        </div>

      </div>

      <!-- Right Column: Results Board (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center bg-slate-50 dark:bg-binance-canvas/90 rounded-2xl p-6 border border-slate-200 dark:border-binance-border relative" id="export-target">
        
        <span class="text-xs font-semibold text-slate-500 dark:text-binance-muted uppercase tracking-wider mb-2">Equated Percentage</span>

        <!-- Percentage Display -->
        <div class="text-center my-3">
          <div class="flex items-baseline justify-center gap-1">
            <span id="result-percentage" class="text-5xl md:text-6xl font-extrabold font-mono text-slate-900 dark:text-binance-yellow tracking-tight drop-shadow-sm">
              --.--
            </span>
            <span class="text-2xl md:text-3xl font-bold font-mono text-slate-900 dark:text-binance-yellow">%</span>
          </div>
          <div id="result-badge" class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border text-slate-600 bg-slate-100 border-slate-300 dark:text-binance-muted dark:bg-binance-card dark:border-binance-border">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-binance-muted"></span>
            <span id="result-status-text">Enter CGPA above</span>
          </div>
        </div>

        <!-- Formula and Validity Info Grid -->
        <div class="w-full grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-slate-200 dark:border-binance-border text-center font-mono">
          <div class="p-2.5 rounded-lg bg-white dark:bg-binance-card border border-slate-200 dark:border-binance-border">
            <span class="text-[11px] text-slate-500 dark:text-binance-muted block">Regulatory Section</span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">Section 16</span>
          </div>
          <div class="p-2.5 rounded-lg bg-white dark:bg-binance-card border border-slate-200 dark:border-binance-border">
            <span class="text-[11px] text-slate-500 dark:text-binance-muted block">Academic Scale</span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">10.00 Points</span>
          </div>
        </div>

        <!-- Action Buttons: Copy, Save Log, PNG Export, PDF Export -->
        <div class="w-full grid grid-cols-2 gap-2 mt-4">
          <button
            id="copy-result-btn"
            type="button"
            class="py-2.5 px-3 rounded-lg bg-white hover:bg-slate-100 dark:bg-binance-card dark:hover:bg-binance-elevated border border-slate-200 dark:border-binance-border text-slate-800 dark:text-white text-xs font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-sm"
          >
            <svg class="w-3.5 h-3.5 text-amber-600 dark:text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-btn-text">Copy Result</span>
          </button>

          <button
            id="save-history-btn"
            type="button"
            class="py-2.5 px-3 rounded-lg bg-binance-yellow hover:bg-binance-yellow-hover text-binance-ink text-xs font-bold flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-sm"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
            </svg>
            <span>Save Log</span>
          </button>

          <button
            id="export-png-btn"
            type="button"
            class="py-2.5 px-3 rounded-lg bg-white hover:bg-slate-100 dark:bg-binance-card dark:hover:bg-binance-elevated border border-slate-200 dark:border-binance-border text-slate-800 dark:text-white text-xs font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-sm"
          >
            <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-binance-turquoise" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span id="export-png-text">Export PNG</span>
          </button>

          <button
            id="export-pdf-btn"
            type="button"
            class="py-2.5 px-3 rounded-lg bg-white hover:bg-slate-100 dark:bg-binance-card dark:hover:bg-binance-elevated border border-slate-200 dark:border-binance-border text-slate-800 dark:text-white text-xs font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-sm"
          >
            <svg class="w-3.5 h-3.5 text-amber-600 dark:text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span id="export-pdf-text">Export PDF</span>
          </button>
        </div>

        <div id="toast-msg" class="hidden absolute bottom-2 px-3 py-1 rounded bg-binance-up text-binance-ink text-xs font-bold shadow-lg transition-all">
          Copied to clipboard!
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  import jsPDF from 'jspdf';

  function calculatePercentage(cgpa: number) {
    if (isNaN(cgpa) || cgpa < 0) return 0;
    if (cgpa > 10) return 92.50;
    const raw = (10.00 * cgpa) - 7.50;
    return Math.max(0, Math.round((raw + Number.EPSILON) * 100) / 100);
  }

  const cgpaInput = document.getElementById('cgpa-input') as HTMLInputElement | null;
  const cgpaSlider = document.getElementById('cgpa-slider') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-btn');
  const resultPercentage = document.getElementById('result-percentage');
  const resultStatusText = document.getElementById('result-status-text');
  const resultBadge = document.getElementById('result-badge');
  const step1Text = document.getElementById('step1-text');
  const step2Text = document.getElementById('step2-text');
  const rangeWarning = document.getElementById('range-warning');
  const inputError = document.getElementById('input-error');
  const copyBtn = document.getElementById('copy-result-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const saveHistoryBtn = document.getElementById('save-history-btn');
  const exportPngBtn = document.getElementById('export-png-btn');
  const exportPngText = document.getElementById('export-png-text');
  const exportPdfBtn = document.getElementById('export-pdf-btn');
  const exportPdfText = document.getElementById('export-pdf-text');
  const toastMsg = document.getElementById('toast-msg');

  function updateAll(rawVal: number | null) {
    if (rawVal === null || isNaN(rawVal)) {
      if (inputError) inputError.classList.add('hidden');
      if (resultPercentage) resultPercentage.textContent = '--.--';
      if (resultStatusText) resultStatusText.textContent = 'Enter CGPA above';
      if (resultBadge) {
        resultBadge.className = 'mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border text-slate-600 bg-slate-100 border-slate-300 dark:text-binance-muted dark:bg-binance-card dark:border-binance-border';
      }
      if (step1Text) step1Text.textContent = '10.00 × -- = --';
      if (step2Text) step2Text.textContent = '-- − 7.50 = --%';
      if (rangeWarning) rangeWarning.classList.add('hidden');
      return;
    }

    if (rawVal < 0 || rawVal > 10) {
      if (inputError) inputError.classList.remove('hidden');
      if (resultPercentage) resultPercentage.textContent = '--.--';
      return;
    } else {
      if (inputError) inputError.classList.add('hidden');
    }

    const clampedVal = Math.min(10, Math.max(0, rawVal));
    const percentage = calculatePercentage(clampedVal);

    if (resultPercentage) {
      resultPercentage.textContent = percentage.toFixed(2);
    }
    if (resultStatusText) {
      resultStatusText.textContent = clampedVal >= 5.0 ? 'Official Range (CGPA ≥ 5.00)' : 'Reference Range (CGPA < 5.00)';
    }
    if (resultBadge) {
      if (clampedVal >= 5.0) {
        resultBadge.className = 'mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border text-emerald-700 bg-emerald-100 border-emerald-300 dark:text-binance-up dark:bg-binance-up/10 dark:border-binance-up/30';
      } else {
        resultBadge.className = 'mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border text-amber-700 bg-amber-100 border-amber-300 dark:text-amber-400 dark:bg-amber-400/10 dark:border-amber-400/30';
      }
    }
    if (step1Text) {
      step1Text.textContent = `10.00 × ${clampedVal.toFixed(2)} = ${(10 * clampedVal).toFixed(2)}`;
    }
    if (step2Text) {
      step2Text.textContent = `${(10 * clampedVal).toFixed(2)} − 7.50 = ${percentage.toFixed(2)}%`;
    }
    if (rangeWarning) {
      if (clampedVal < 5.0 && clampedVal > 0) {
        rangeWarning.classList.remove('hidden');
      } else {
        rangeWarning.classList.add('hidden');
      }
    }
  }

  if (cgpaInput && cgpaSlider) {
    cgpaInput.addEventListener('input', () => {
      const text = cgpaInput.value.trim();
      if (text === '') {
        cgpaSlider.value = '0';
        updateAll(null);
      } else {
        const val = parseFloat(text);
        if (!isNaN(val)) {
          if (val >= 0 && val <= 10) {
            cgpaSlider.value = String(val);
          }
          updateAll(val);
        } else {
          updateAll(NaN);
        }
      }
    });

    cgpaSlider.addEventListener('input', () => {
      const val = parseFloat(cgpaSlider.value);
      cgpaInput.value = val.toFixed(2);
      updateAll(val);
    });

    clearBtn?.addEventListener('click', () => {
      cgpaInput.value = '';
      cgpaSlider.value = '0';
      updateAll(null);
      cgpaInput.focus();
    });

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const val = parseFloat(target.dataset.preset || '0');
        cgpaInput.value = val.toFixed(2);
        cgpaSlider.value = String(val);
        updateAll(val);
      });
    });

    // Start with empty input state on initial load
    updateAll(null);
  }

  // Copy result action
  if (copyBtn && copyBtnText && toastMsg) {
    copyBtn.addEventListener('click', () => {
      const cgpa = cgpaInput?.value.trim();
      if (!cgpa) {
        alert('Please enter a CGPA value first.');
        return;
      }
      const per = resultPercentage?.textContent || '0.00';
      const text = `WCE CGPA to Percentage Conversion:\nCGPA: ${cgpa}/10.00\nPercentage: ${per}%\nFormula: (10.00 × CGPA) − 7.50 (Section 16)`;

      navigator.clipboard.writeText(text).then(() => {
        copyBtnText.textContent = 'Copied!';
        toastMsg.classList.remove('hidden');
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Result';
          toastMsg.classList.add('hidden');
        }, 2000);
      });
    });
  }

  // Save history action
  if (saveHistoryBtn) {
    saveHistoryBtn.addEventListener('click', () => {
      const text = cgpaInput?.value.trim();
      if (!text) {
        alert('Please enter a CGPA value first to save it to history.');
        return;
      }
      const cgpa = parseFloat(text);
      const per = parseFloat(resultPercentage?.textContent || '0');
      
      const item = {
        id: Date.now().toString(),
        cgpa,
        percentage: per,
        gradeClass: `Formula: (10 × ${cgpa.toFixed(2)}) − 7.50`,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        date: new Date().toLocaleDateString()
      };

      const existing = JSON.parse(localStorage.getItem('wce_calc_history') || '[]');
      existing.unshift(item);
      localStorage.setItem('wce_calc_history', JSON.stringify(existing.slice(0, 15)));

      window.dispatchEvent(new CustomEvent('wce-history-updated'));

      if (saveHistoryBtn) {
        const orig = saveHistoryBtn.innerHTML;
        saveHistoryBtn.innerHTML = `<span>Saved!</span>`;
        setTimeout(() => { saveHistoryBtn.innerHTML = orig; }, 1500);
      }
    });
  }

  // High-resolution certificate canvas generator (Zero CSS parsing dependency, instant, works in all browsers)
  function generateCertificateCanvas(cgpa: number, percentage: number, isDark: boolean): HTMLCanvasElement {
    const canvas = document.createElement('canvas');
    canvas.width = 1200;
    canvas.height = 760;
    const ctx = canvas.getContext('2d');
    if (!ctx) return canvas;

    const bg = isDark ? '#181a20' : '#ffffff';
    const cardBg = isDark ? '#1e2329' : '#f8fafc';
    const textColor = isDark ? '#eaecef' : '#0f172a';
    const mutedColor = isDark ? '#848e9c' : '#64748b';
    const gold = '#fcd535';
    const green = '#0ecb81';
    const border = isDark ? '#2b3139' : '#e2e8f0';

    // Canvas background
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Outer card with rounded corners
    ctx.fillStyle = cardBg;
    ctx.strokeStyle = border;
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.roundRect(40, 40, 1120, 680, 24);
    ctx.fill();
    ctx.stroke();

    // Top Header Banner
    ctx.fillStyle = gold;
    ctx.beginPath();
    ctx.roundRect(80, 80, 80, 40, 8);
    ctx.fill();

    ctx.font = 'bold 20px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = '#181a20';
    ctx.textAlign = 'center';
    ctx.fillText('WCE', 120, 108);

    ctx.textAlign = 'left';
    ctx.fillStyle = textColor;
    ctx.font = 'bold 28px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText('Walchand College of Engineering, Sangli', 180, 105);

    ctx.font = '16px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = mutedColor;
    ctx.fillText('Official Grade Conversion Record • Academic Regulations Section 16', 180, 130);

    // Divider
    ctx.strokeStyle = border;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(80, 160);
    ctx.lineTo(1120, 160);
    ctx.stroke();

    // Central Metric Cards
    // CGPA Box
    ctx.fillStyle = isDark ? '#0b0e11' : '#ffffff';
    ctx.strokeStyle = border;
    ctx.beginPath();
    ctx.roundRect(80, 190, 490, 240, 16);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = mutedColor;
    ctx.font = 'bold 15px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText('CUMULATIVE GRADE POINT AVERAGE', 110, 235);

    ctx.fillStyle = textColor;
    ctx.font = 'bold 64px "IBM Plex Mono", monospace';
    ctx.fillText(cgpa.toFixed(2), 110, 320);

    ctx.fillStyle = mutedColor;
    ctx.font = '20px "IBM Plex Mono", monospace';
    ctx.fillText('/ 10.00 Scale', 300, 315);

    ctx.fillStyle = green;
    ctx.font = 'bold 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText('STATUS: VERIFIED GRADE', 110, 380);

    // Percentage Box
    ctx.fillStyle = isDark ? '#0b0e11' : '#ffffff';
    ctx.strokeStyle = border;
    ctx.beginPath();
    ctx.roundRect(610, 190, 510, 240, 16);
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = mutedColor;
    ctx.font = 'bold 15px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText('EQUATED PERCENTAGE OF MARKS', 640, 235);

    ctx.fillStyle = gold;
    ctx.font = 'bold 64px "IBM Plex Mono", monospace';
    ctx.fillText(`${percentage.toFixed(2)}%`, 640, 320);

    ctx.fillStyle = green;
    ctx.font = 'bold 16px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText('TRANSCRIPT EQUIVALENCE: APPROVED', 640, 380);

    // Formula Breakdown Box
    ctx.fillStyle = isDark ? '#0b0e11' : '#f1f5f9';
    ctx.beginPath();
    ctx.roundRect(80, 460, 1040, 130, 14);
    ctx.fill();

    ctx.fillStyle = textColor;
    ctx.font = 'bold 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText('Official Conversion Formula (Section 16):', 110, 500);

    ctx.fillStyle = gold;
    ctx.font = 'bold 22px "IBM Plex Mono", monospace';
    ctx.fillText(`Percentage = (10.00 × CGPA) − 7.50`, 110, 540);

    ctx.fillStyle = textColor;
    ctx.font = '18px "IBM Plex Mono", monospace';
    ctx.fillText(`Calculated: (10.00 × ${cgpa.toFixed(2)}) − 7.50 = ${percentage.toFixed(2)}%`, 600, 540);

    // Footer Timestamp & Disclaimer
    ctx.fillStyle = mutedColor;
    ctx.font = '14px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText(`Generated on: ${new Date().toLocaleString()} • WCE Academic & Examination Regulations 2023-24`, 80, 640);
    ctx.fillText('This is an independent academic computation tool calibrated to official WCE Autonomous regulations.', 80, 665);

    return canvas;
  }

  // Export as PNG
  if (exportPngBtn) {
    exportPngBtn.addEventListener('click', () => {
      const cgpa = parseFloat(cgpaInput?.value || '8.25');
      if (isNaN(cgpa)) {
        alert('Please enter a valid CGPA first.');
        return;
      }
      try {
        if (exportPngText) exportPngText.textContent = 'Generating...';
        exportPngBtn.classList.add('opacity-50');
        const percentage = calculatePercentage(cgpa);
        const isDark = document.documentElement.classList.contains('dark');
        const canvas = generateCertificateCanvas(cgpa, percentage, isDark);
        
        const imgUri = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.download = `WCE_CGPA_${cgpa.toFixed(2)}_to_Percentage_${percentage.toFixed(2)}.png`;
        a.href = imgUri;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } catch (err) {
        console.error('PNG export failed:', err);
        alert('PNG export error: ' + (err as Error).message);
      } finally {
        if (exportPngText) exportPngText.textContent = 'Export PNG';
        exportPngBtn.classList.remove('opacity-50');
      }
    });
  }

  // Export as PDF
  if (exportPdfBtn) {
    exportPdfBtn.addEventListener('click', () => {
      const cgpa = parseFloat(cgpaInput?.value || '8.25');
      if (isNaN(cgpa)) {
        alert('Please enter a valid CGPA first.');
        return;
      }
      try {
        if (exportPdfText) exportPdfText.textContent = 'Generating...';
        exportPdfBtn.classList.add('opacity-50');
        const percentage = calculatePercentage(cgpa);
        const isDark = document.documentElement.classList.contains('dark');
        const canvas = generateCertificateCanvas(cgpa, percentage, isDark);
        
        const imgData = canvas.toDataURL('image/png');
        const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        pdf.addImage(imgData, 'PNG', 15, 15, 267, 169);
        pdf.save(`WCE_CGPA_${cgpa.toFixed(2)}_Conversion_Report.pdf`);
      } catch (err) {
        console.error('PDF export failed:', err);
        alert('PDF export error: ' + (err as Error).message);
      } finally {
        if (exportPdfText) exportPdfText.textContent = 'Export PDF';
        exportPdfBtn.classList.remove('opacity-50');
      }
    });
  }
</script>
