---
// Footer.astro - Binance aesthetic dark footer
---

<footer class="bg-binance-canvas border-t border-binance-border mt-16 text-xs text-binance-muted">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Info -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-binance-yellow flex items-center justify-center font-bold text-binance-ink text-xs">
            W
          </div>
          <span class="font-bold text-sm text-white tracking-tight">WCE CALC</span>
        </div>
        <p class="text-xs text-binance-muted leading-relaxed">
          Autonomous CGPA to percentage conversion utility dedicated to Walchand College of Engineering (WCE), Sangli students and alumni.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-binance-card border border-binance-border text-[11px] font-mono text-binance-up">
            <span class="w-1.5 h-1.5 rounded-full bg-binance-up"></span>
            Verified with RR 2023-24
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold text-white mb-3 text-sm">Tools</h4>
        <ul class="space-y-2 font-mono">
          <li><a href="/" class="hover:text-binance-yellow transition-colors">CGPA to % Converter</a></li>
          <li><a href="/semester-calculator" class="hover:text-binance-yellow transition-colors">Semester SGPA Aggregator</a></li>
          <li><a href="/how-it-works#grading-scale" class="hover:text-binance-yellow transition-colors">WCE 10-Point Scale</a></li>
          <li><a href="/how-it-works#formula" class="hover:text-binance-yellow transition-colors">Section 16 Formula</a></li>
        </ul>
      </div>

      <!-- Academic Resources -->
      <div>
        <h4 class="font-semibold text-white mb-3 text-sm">Resources</h4>
        <ul class="space-y-2">
          <li><a href="/how-it-works" class="hover:text-binance-yellow transition-colors">Academic Rules Guide</a></li>
          <li><a href="/about" class="hover:text-binance-yellow transition-colors">About WCE Sangli</a></li>
          <li><a href="/contact" class="hover:text-binance-yellow transition-colors">Contact & Feedback</a></li>
          <li><a href="https://walchandsangli.ac.in" target="_blank" rel="noopener noreferrer" class="hover:text-binance-yellow transition-colors flex items-center gap-1">
            <span>WCE Official Portal</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a></li>
        </ul>
      </div>

      <!-- Legal & Disclaimer -->
      <div>
        <h4 class="font-semibold text-white mb-3 text-sm">Legal & Disclaimer</h4>
        <ul class="space-y-2">
          <li><a href="/privacy" class="hover:text-binance-yellow transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-binance-yellow transition-colors">Terms of Use & Disclaimer</a></li>
        </ul>
        <div class="mt-4 p-2.5 rounded bg-binance-card border border-binance-border/60 text-[11px] text-binance-muted/80">
          Independent educational utility. Walchand College of Engineering and WCE logos are trademarks of their respective institution.
        </div>
      </div>

    </div>

    <div class="pt-8 border-t border-binance-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-binance-muted">
        © {new Date().getFullYear()} WCE CGPA to Percentage Calculator. Designed with Binance Theme Precision.
      </p>
      <div class="flex items-center gap-4 text-xs">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-binance-yellow transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>Open Source</span>
        </a>
      </div>
    </div>
  </div>
</footer>
