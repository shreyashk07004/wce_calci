---
// Footer.astro - Binance aesthetic footer with exact original content and light/dark theme support
---

<footer class="bg-slate-100 dark:bg-binance-canvas text-slate-600 dark:text-binance-muted py-8 sm:py-10 border-t border-slate-200 dark:border-binance-border transition-colors duration-150 mt-auto font-sans text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Persistent Site-Wide Disclaimer Banner -->
    <div class="p-4 rounded-xl bg-white dark:bg-binance-card border border-slate-200 dark:border-binance-border text-xs text-slate-700 dark:text-binance-text space-y-1.5 leading-relaxed">
      <div class="flex items-center gap-2 font-bold text-amber-600 dark:text-binance-yellow">
        <svg class="w-4 h-4 shrink-0 text-amber-600 dark:text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>Disclaimer & Legal Notice</span>
      </div>
      <p class="text-slate-600 dark:text-binance-muted text-xs leading-relaxed">
        This is an independent, unofficial tool built by a student for the convenience of WCE Sangli students. It is not affiliated with, endorsed by, or an official product of Walchand College of Engineering. Calculations are based on the published WCE Academic and Examination Rules and Regulations 2023-24. Always verify your official CGPA and percentage with the WCE Examination Section or your official grade card.
      </p>
    </div>

    <!-- Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 pt-2">
      <!-- Brand Column -->
      <div class="md:col-span-5 space-y-3">
        <div class="flex items-center space-x-3">
          <div class="w-fit min-w-[42px] h-8 sm:h-9 px-2.5 py-1 rounded bg-binance-yellow text-binance-ink flex items-center justify-center font-bold text-xs sm:text-sm tracking-normal shrink-0 select-none shadow-sm">
            WCE
          </div>
          <span class="font-bold text-slate-900 dark:text-white text-base">
            WCE CGPA Converter
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-binance-muted leading-relaxed max-w-sm">
          Free CGPA to percentage converter tool for Walchand College of Engineering, Sangli.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs text-slate-700 bg-white border border-slate-200 dark:text-binance-text dark:bg-binance-card dark:border-binance-border font-mono">
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-binance-up shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <span>100% Client-Side • Zero Backend • No Tracking</span>
        </div>
      </div>

      <!-- Tools Quick Links -->
      <div class="md:col-span-4 space-y-2">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">
          Quick Links
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              CGPA to Percentage Converter
            </a>
          </li>
          <li>
            <a href="/sgpa-target-planner" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              Target SGPA Planner
            </a>
          </li>
          <li>
            <a href="/how-its-calculated" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              Official WCE Formula Breakdown
            </a>
          </li>
          <li>
            <a href="/history" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              Saved Calculation History
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal & Info Links -->
      <div class="md:col-span-3 space-y-2">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">
          Legal & Information
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/privacy-policy" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              Terms of Use & Disclaimer
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              About Us
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-amber-600 dark:hover:text-binance-yellow transition-colors py-0.5 inline-block">
              Contact Us
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar & Footer Links -->
    <div class="pt-4 border-t border-slate-200 dark:border-binance-border flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-binance-muted gap-4">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-3 gap-y-1.5 text-center sm:text-left">
        <span>© {new Date().getFullYear()} WCE CGPA to Percentage Converter</span>
        <span class="hidden sm:inline">•</span>
        <a href="/privacy-policy" class="hover:text-amber-600 dark:hover:text-binance-yellow underline transition-colors">
          Privacy Policy
        </a>
        <span>|</span>
        <a href="/terms" class="hover:text-amber-600 dark:hover:text-binance-yellow underline transition-colors">
          Terms of Use
        </a>
        <span>|</span>
        <a href="/about" class="hover:text-amber-600 dark:hover:text-binance-yellow underline transition-colors">
          About
        </a>
        <span>|</span>
        <a href="/contact" class="hover:text-amber-600 dark:hover:text-binance-yellow underline transition-colors">
          Contact
        </a>
      </div>

      <div class="flex items-center gap-1 shrink-0">
        <span>Crafted with</span>
        <svg class="w-3.5 h-3.5 text-red-500 fill-red-500 inline" viewBox="0 0 24 24">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
        </svg>
        <span>for WCE Sangli</span>
      </div>
    </div>
  </div>
</footer>
