---
// FaqSection.astro - Accordion for WCE Academic Queries
const faqs = [
  {
    q: "What is the official WCE Sangli CGPA to Percentage conversion formula?",
    a: "According to Section 16 of the Walchand College of Engineering (WCE) Academic and Examination Rules and Regulations (2023-24), the official formula is: Percentage = (10.00 × CGPA) − 7.50. For example, a CGPA of 7.80 equates to (10.00 × 7.80) − 7.50 = 70.50%."
  },
  {
    q: "Is this conversion formula valid for CGPA less than 5.00?",
    a: "Under Section 16 of the WCE Academic Regulations, this linear conversion formula is officially specified for CGPA ≥ 5.00. For scores below 5.00, calculations are provided for mathematical reference."
  },
  {
    q: "How does WCE calculate SGPA and CGPA across semesters?",
    a: "SGPA (Semester Grade Point Average) is calculated as Σ(Credit × Grade Point) / Σ(Credits) in that semester. CGPA is the cumulative weighted average of all courses across all completed semesters."
  },
  {
    q: "Is this conversion formula accepted by recruiters and higher studies institutions?",
    a: "This formula is the official conversion standard printed on Walchand College of Engineering (WCE) grade cards and transcripts as approved under Section 16 of the institute's Academic and Examination Rules and Regulations. However, acceptance criteria may vary by organization, employer, university, or regulatory body. Students are advised to independently confirm specific conversion guidelines and transcript submission requirements directly with the prospective employer or academic institution."
  }
];
---

<div class="bg-white dark:bg-binance-card rounded-2xl border border-slate-200 dark:border-binance-border p-6 md:p-8 transition-colors duration-150">
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-mono font-bold uppercase text-amber-600 dark:text-binance-yellow">Frequently Asked Questions</span>
    </div>
    <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white">WCE Autonomous Grading & Equivalency</h3>
  </div>

  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group bg-slate-50 dark:bg-binance-canvas rounded-xl border border-slate-200 dark:border-binance-border overflow-hidden transition-all [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex items-center justify-between p-4 cursor-pointer select-none font-medium text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-binance-yellow transition-colors">
          <span class="text-sm font-semibold pr-4">{faq.q}</span>
          <svg class="w-4 h-4 shrink-0 text-slate-400 dark:text-binance-muted group-hover:text-amber-600 dark:group-hover:text-binance-yellow transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="px-4 pb-4 pt-1 text-xs text-slate-600 dark:text-binance-muted leading-relaxed border-t border-slate-200 dark:border-binance-border/40 font-mono">
          {faq.a}
        </div>
      </details>
    ))}
  </div>
</div>
