---
// ConversionTable.astro - Official WCE Standard Conversion Reference Table (Section 16)
const cgpaList = [
  { cgpa: '10.00', calc: '(10.00 × 10.00) − 7.50', pct: '92.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '9.75', calc: '(10.00 × 9.75) − 7.50', pct: '90.00%', note: 'Calculated Value', highlight: false },
  { cgpa: '9.50', calc: '(10.00 × 9.50) − 7.50', pct: '87.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '9.25', calc: '(10.00 × 9.25) − 7.50', pct: '85.00%', note: 'Calculated Value', highlight: false },
  { cgpa: '9.00', calc: '(10.00 × 9.00) − 7.50', pct: '82.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '8.75', calc: '(10.00 × 8.75) − 7.50', pct: '80.00%', note: 'Calculated Value', highlight: false },
  { cgpa: '8.50', calc: '(10.00 × 8.50) − 7.50', pct: '77.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '8.25', calc: '(10.00 × 8.25) − 7.50', pct: '75.00%', note: 'Official WCE Verification Table Value', highlight: true },
  { cgpa: '8.00', calc: '(10.00 × 8.00) − 7.50', pct: '72.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '7.80', calc: '(10.00 × 7.80) − 7.50', pct: '70.50%', note: 'Worked Example in WCE Regulations', highlight: true },
  { cgpa: '7.75', calc: '(10.00 × 7.75) − 7.50', pct: '70.00%', note: 'Official WCE Verification Table Value', highlight: true },
  { cgpa: '7.50', calc: '(10.00 × 7.50) − 7.50', pct: '67.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '7.25', calc: '(10.00 × 7.25) − 7.50', pct: '65.00%', note: 'Official WCE Verification Table Value', highlight: true },
  { cgpa: '7.00', calc: '(10.00 × 7.00) − 7.50', pct: '62.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '6.75', calc: '(10.00 × 6.75) − 7.50', pct: '60.00%', note: 'Official WCE Verification Table Value', highlight: true },
  { cgpa: '6.50', calc: '(10.00 × 6.50) − 7.50', pct: '57.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '6.25', calc: '(10.00 × 6.25) − 7.50', pct: '55.00%', note: 'Official WCE Verification Table Value', highlight: true },
  { cgpa: '6.00', calc: '(10.00 × 6.00) − 7.50', pct: '52.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '5.50', calc: '(10.00 × 5.50) − 7.50', pct: '47.50%', note: 'Calculated Value', highlight: false },
  { cgpa: '5.00', calc: '(10.00 × 5.00) − 7.50', pct: '42.50%', note: 'Official Base Threshold (CGPA ≥ 5.00)', highlight: true },
];
---

<div class="bg-white dark:bg-binance-card rounded-2xl border border-slate-200 dark:border-binance-border overflow-hidden transition-colors duration-150">
  <div class="px-6 py-4 bg-slate-50 dark:bg-binance-elevated/60 border-b border-slate-200 dark:border-binance-border flex flex-wrap items-center justify-between gap-4">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-600 dark:text-binance-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 3v18h18"/>
          <path d="M18 17V9"/>
          <path d="M13 17V5"/>
          <path d="M8 17v-3"/>
        </svg>
        WCE Standard Conversion Reference Table
      </h3>
      <p class="text-xs text-slate-500 dark:text-binance-muted">Reference values evaluated using Section 16 formula: Percentage = (10.00 × CGPA) − 7.50</p>
    </div>

    <!-- Live Search input -->
    <div class="relative w-full sm:w-64">
      <input
        type="text"
        id="table-search"
        placeholder="Filter CGPA (e.g. 7.75)..."
        class="w-full bg-white dark:bg-binance-canvas border border-slate-300 dark:border-binance-border focus:border-binance-yellow text-slate-900 dark:text-white text-xs px-3 py-2 pl-8 rounded-lg outline-none font-mono"
      />
      <svg class="w-3.5 h-3.5 text-slate-400 dark:text-binance-muted absolute left-2.5 top-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
  </div>

  <div class="overflow-x-auto max-h-[460px] scrollbar-thin">
    <table class="w-full text-left border-collapse text-xs font-mono" id="conversion-data-table">
      <thead>
        <tr class="bg-slate-100/90 dark:bg-binance-canvas/90 text-slate-600 dark:text-binance-muted uppercase text-[11px] tracking-wider sticky top-0 border-b border-slate-200 dark:border-binance-border z-10 backdrop-blur-sm">
          <th class="py-3 px-6">CGPA</th>
          <th class="py-3 px-6">Applied Formula</th>
          <th class="py-3 px-6">Equated Percentage</th>
          <th class="py-3 px-6">Status / Source</th>
          <th class="py-3 px-6 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-binance-border/60">
        {cgpaList.map((row) => (
          <tr class={`hover:bg-slate-50 dark:hover:bg-binance-elevated/50 transition-colors group ${row.highlight ? 'bg-amber-50/50 dark:bg-binance-yellow/[0.02]' : ''}`}>
            <td class="py-3 px-6 font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-binance-yellow transition-colors flex items-center gap-2">
              {row.highlight && <span class="w-1.5 h-1.5 rounded-full bg-amber-500 dark:bg-binance-yellow"></span>}
              {row.cgpa}
            </td>
            <td class="py-3 px-6 text-slate-600 dark:text-binance-muted">
              {row.calc}
            </td>
            <td class="py-3 px-6 text-emerald-700 dark:text-binance-up font-bold text-sm">
              {row.pct}
            </td>
            <td class="py-3 px-6 text-slate-500 dark:text-slate-400 text-xs">
              <span class={row.highlight ? 'text-amber-700 dark:text-binance-yellow font-medium' : ''}>
                {row.note}
              </span>
            </td>
            <td class="py-3 px-6 text-right">
              <button
                type="button"
                data-cgpa={row.cgpa}
                class="apply-table-cgpa text-[11px] px-2.5 py-1 rounded bg-slate-100 hover:bg-binance-yellow hover:text-binance-ink border border-slate-300 dark:bg-binance-canvas dark:hover:bg-binance-yellow dark:hover:text-binance-ink dark:border-binance-border text-slate-700 dark:text-binance-muted hover:border-binance-yellow font-medium transition-all cursor-pointer"
              >
                Load
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  const searchInput = document.getElementById('table-search') as HTMLInputElement | null;
  const table = document.getElementById('conversion-data-table');

  if (searchInput && table) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();
      const rows = table.querySelectorAll('tbody tr');
      
      rows.forEach(row => {
        const text = row.textContent?.toLowerCase() || '';
        if (text.includes(query)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  }

  document.querySelectorAll('.apply-table-cgpa').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const cgpa = (e.currentTarget as HTMLButtonElement).dataset.cgpa;
      const mainInput = document.getElementById('cgpa-input') as HTMLInputElement | null;
      if (mainInput && cgpa) {
        mainInput.value = cgpa;
        mainInput.dispatchEvent(new Event('input', { bubbles: true }));
        document.getElementById('calculator')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
